{
  "name": "ClairScan",
  "short_name": "ClairScan",
  "description": "Scanner de documents sans publicité, qui fonctionne hors ligne.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0e1014",
